# 服务器配置
PORT=3000
NODE_ENV=development

# 数据库配置
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=pandamart_pms

# JWT 配置
JWT_SECRET=
JWT_EXPIRES_IN=86400

# AI API Key 加密密钥（AES-256，必须 32 字符）
AI_ENCRYPTION_KEY=

# Seed 配置（开发/测试使用）
SEED_ADMIN_PASSWORD=
SEED_DEFAULT_AI_PROVIDER_API_KEY=

# CORS 允许的前端地址（多个用逗号分隔）
CORS_ORIGIN=http://localhost:5173

# 文件上传
UPLOAD_DIR=uploads
MAX_FILE_SIZE=20971520

# 限流配置（可选，单位：每窗口最大请求数）
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_LOGIN_MAX=5
# RATE_LIMIT_API_MAX=100
# RATE_LIMIT_OCR_MAX=10
# RATE_LIMIT_AI_MAX=20
# RATE_LIMIT_EXPORT_MAX=5
# RATE_LIMIT_AI_PROVIDER_TEST_MAX=5

# SMTP 邮件配置（可选）
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# E2E 集成测试（可选）
E2E_ADMIN_USERNAME=admin
E2E_ADMIN_PASSWORD=
# 生产环境默认 false，开发环境默认 true
E2E_RUN_MIGRATIONS=true
E2E_RUN_SEEDS=true
# 是否执行写链路（创建/删除供应商）
E2E_WRITE_TEST=false
# 是否执行限流回归
E2E_RATE_LIMIT_REGRESSION=false
